NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 開発者ログイン（ログイン画面の「</>」ボタン）用パスワード。サーバー専用（NEXT_PUBLIC_なし）。
# ★これを知っていれば全店舗を横断できる developer 権限に到達できる、最も強い入口。
# 24文字以上のランダム文字列にすること（未満だとAPIが 503 を返して開かない）。
# 生成: openssl rand -base64 24  もしくは  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 環境ごとに別の値にする（本番とローカルで揃える必要はない）。
DEV_LOGIN_PASSWORD=change-me-to-a-24-chars-or-longer-random-string

# セッションCookie（shift_session）の署名鍵。サーバー専用（NEXT_PUBLIC_なし）。
# 未設定だとログイン系のAPIが 500 で落ちる（lib/session.ts が例外を投げる）。
# ランダムな長い文字列を各環境で個別に生成する: openssl rand -hex 32
# ★この値を変えると発行済みのセッションCookieが全て無効になり、全員が再ログインになる。
#   退職者やPIN漏洩に即時対応するときの緊急手段でもある（docs/OPERATIONS.md）。
SESSION_SECRET=change-me

# RLSを完全にバイパスするSupabaseの管理者キー。サーバー専用（NEXT_PUBLIC_なし）。
# スタッフのCRUD・店舗CRUD・要望の保存など、APIルートからの書込みに使う。
# Supabaseダッシュボード > Project Settings > API > service_role で取得する。
# ★クライアントに露出させないこと。漏れると全店舗の全データが読み書きできる。
SUPABASE_SERVICE_ROLE_KEY=change-me

# httpOnly CookieセッションからSupabase用JWT（app_role/store_idクレーム入り）を署名するための鍵。
# サーバー専用（NEXT_PUBLIC_なし）。Supabaseダッシュボード > Project Settings > API >
# JWT Settings の Legacy JWT Secret と同じ値を設定すること（RLS側のauth.jwt()検証と一致させる必要がある）。
SUPABASE_JWT_SECRET=change-me

# 「要望の送信」機能（destination='dev'）が使うGitHub Issue作成用トークン。サーバー専用
# （NEXT_PUBLIC_なし）。未設定の場合はIssue作成だけをスキップし、要望の送信自体は正常に動作する。
# GitHub > Settings > Developer settings > Fine-grained personal access tokens で発行し、
# 対象リポジトリをこのリポジトリ（flshwrks/shift-app）に限定、権限は
# Repository permissions > Issues: Read and write のみ付与すること（他の権限は不要）。
GITHUB_TOKEN=

# 上記トークンでIssueを作成する対象リポジトリ（"owner/repo"形式）。未設定時は
# flshwrks/shift-app を使う。フォーク先など別リポジトリで運用する場合のみ設定する。
GITHUB_FEEDBACK_REPO=flshwrks/shift-app
